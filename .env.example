# Copy to .env (ignored by git) and fill in. Never commit real values.
# On the Pi, raspi-manager loads the env file through systemd (EnvironmentFile); for local runs use `node --env-file=.env ...`.

# Bot token from the Discord developer portal. Required.
DISCORD_TOKEN=change-me-bot-token
# Comma-separated ids of the servers to record. Required: nothing is recorded outside this list.
ALLOWED_GUILD_IDS=change-me-server-id,change-me-another-server-id
# Absolute path of the SQLite file, OUTSIDE the application folder (updates replace that folder). Required.
DB_PATH=/home/change-me-user/data/vocalog/vocalog.sqlite

# --- Web server (server/) ---
# Port the server listens on (127.0.0.1 only; a tunnel connects to it). Optional, default 3000.
PORT=3000
# Time zone for hours, weekdays and days in the statistics. Optional, default Europe/Paris.
STATS_TIME_ZONE=Europe/Paris
# Absolute path of the built web app (web/dist). Optional: without it the server only serves the API.
WEB_DIR=/home/change-me-user/apps/vocalog/web/dist
# Discord login of the dashboard (the server refuses to start without these four, or without INSECURE_NO_AUTH=1).
# In the Discord developer portal, OAuth2 page: copy the Client ID and Client Secret, and add the redirect
# <PUBLIC_URL>/auth/callback . Only the scopes `identify` and `guilds` are used; no privileged intent.
DISCORD_CLIENT_ID=change-me-client-id
DISCORD_CLIENT_SECRET=change-me-client-secret
# At least 32 random characters, to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The value below is deliberately too short: the server refuses to start until you replace it.
SESSION_SECRET=change-me
# Public address of the dashboard, origin only (https required, except http://localhost for tests).
PUBLIC_URL=https://change-me.example.com

# LOCAL DEVELOPMENT ONLY, instead of the four lines above: run without any login. The server refuses to
# start if this is set together with them. NEVER set it on a host reachable from outside (a tunnel counts).
# INSECURE_NO_AUTH=1
